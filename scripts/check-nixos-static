#!/usr/bin/env bash

set -euo pipefail

test -f flake.lock
test -f nixos/disko.nix
test -x nixos/install-blank-disk.sh

bash -n nixos/install-from-minimal.sh
bash -n nixos/install-blank-disk.sh
bash -n .bashrc
shellcheck nixos/install-from-minimal.sh nixos/install-blank-disk.sh
luac -p nixos/hypr/hyprland.lua
jq --exit-status . nixos/hypr/waybar.jsonc >/dev/null

if rg -n 'name = "vtop"|name = "spotify-launcher"' nixos/packages.nix; then
  echo "Removed package/command names reappeared in the NixOS migration." >&2
  exit 1
fi

if rg -n 'command:.*xdotool key' .config/fusuma/config.yml; then
  echo "Fusuma regressed to the slower xdotool command workaround." >&2
  exit 1
fi
rg -q 'sendkey: LEFTMETA' .config/fusuma/config.yml
rg -q 'name = "ruby-fusuma"' nixos/packages.nix
rg -q '"input"' nixos/configuration.nix

if rg -n 'framework-13|7040|dots-framework' \
  flake.nix nixos/install-from-minimal.sh nixos/install-blank-disk.sh; then
  echo "A removed hardware/profile variant reappeared." >&2
  exit 1
fi

if rg -ni 'dangerzone' nixos flake.nix; then
  echo "Dangerzone should not be part of this migration." >&2
  exit 1
fi

if rg -n 'nixos-unstable|github:nix-community/home-manager"' flake.nix; then
  echo "An unpinned flake input reappeared." >&2
  exit 1
fi

rg -q 'disko.nixosModules.disko' flake.nix
rg -q 'github:nix-community/disko/[0-9a-f]{40}' flake.nix
rg -q 'device = "/dev/nvme0n1";' nixos/disko.nix
rg -q -- '--no-filesystems' nixos/install-from-minimal.sh
rg -q -- '--mode destroy,format,mount' nixos/install-blank-disk.sh
if rg -n '\b(parted|mkfs\.(ext4|fat)|wipefs)\b' nixos/install-blank-disk.sh; then
  echo "Blank-disk layout must be applied by Disko, not imperative formatting commands." >&2
  exit 1
fi

if rg -n 'source = ../\.config/(BetterDiscord|flameshot|gtk-3.0|keepassxc);$' nixos/home.nix; then
  echo "Mutable application directories must not be recursively store-managed." >&2
  exit 1
fi

test -f nixos/COMPATIBILITY.md
test -f nixos/MIGRATION.md
