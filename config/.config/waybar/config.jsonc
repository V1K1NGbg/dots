{
  "layer": "top",
  "position": "top",
  "start_hidden": true,
  "height": 30,
  "spacing": 6,
  "on-sigusr1": "toggle",
  "modules-left": ["hyprland/workspaces", "hyprland/workspaces#windows"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "battery"],
  "clock": {
    "format": "{:%Y-%m-%d  %H:%M}"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "sort-by-id": true,
    "active-only": false,
    "all-outputs": true,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
    },
    "on-click": "activate",
    "disable-scroll": true
  },
  "hyprland/workspaces#windows": {
    "active-only": true,
    "all-outputs": false,
    "format": "{windows}",
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": true,
      "format": "{icon}",
      "icon-size": 16,
      "orientation": "horizontal",
      "on-click-window": "/home/victor/.config/waybar/focus-window.sh {address}"
    }
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%",
    "format-charging": "{capacity}%"
  },
  "tray": {
    "spacing": 8
  }
}
