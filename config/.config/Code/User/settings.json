{
    "explorer.confirmDragAndDrop": false,
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "explorer.confirmDelete": false,
    "editor.minimap.enabled": true,
    "security.workspace.trust.untrustedFiles": "open",
    "editor.mouseWheelZoom": true,
    "redhat.telemetry.enabled": false,
    "files.autoGuessEncoding": true,
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
    },
    "prettier.tabWidth": 4,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "[python]": {
        "editor.formatOnType": true,
    },
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.formatOnSave": true,
    "color-highlight.markerType": "outline",
    "files.autoSaveDelay": 1000,
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features",
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
    },
    "debug.onTaskErrors": "showErrors",
    "debug.allowBreakpointsEverywhere": true,
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "editor.linkedEditing": true,
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "terminal.integrated.gpuAcceleration": "off",
    "terminal.integrated.customGlyphs": false,
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-1.8",
            "path": "/usr/lib/jvm/java-8-openjdk",
        },
        {
            "name": "JavaSE-21",
            "path": "/usr/lib/jvm/java-21-openjdk",
        },
    ],
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.maxComputationTime": 0,
    "settingsSync.ignoredSettings": ["-window.zoomLevel"],
    "update.showReleaseNotes": false,
    "workbench.startupEditor": "none",
    "explorer.confirmPasteNative": false,
    "workbench.editor.empty.hint": "hidden",
    "workbench.colorTheme": "Monokai Mega",
    "window.menuBarVisibility": "toggle",
    "git.ignoreRebaseWarning": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "errorLens.enabledDiagnosticLevels": ["error", "warning"],
    "editor.unicodeHighlight.includeComments": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.tree.indent": 20,
    "emmet.variables": {
        "lang": "en",
    },
    "cSpell.diagnosticLevel": "Hint",
    "terminal.integrated.tabs.hideCondition": "never",
    "terminal.integrated.enablePersistentSessions": false,
    "java.compile.nullAnalysis.mode": "automatic",
    "java.configuration.detectJdksAtStart": false,
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.debug.settings.hotCodeReplace": "auto",
    "java.dependency.packagePresentation": "hierarchical",
    "java.maxConcurrentBuilds": 20,
    "java.sources.organizeImports.staticStarThreshold": 1,
    "maven.terminal.customEnv": [
        {
            "environmentVariable": "JAVA_HOME",
            "value": "/usr/lib/jvm/java-21-openjdk",
        },
    ],
    "java.import.gradle.java.home": "/usr/lib/jvm/java-21-openjdk",
    "[markdown]": {
        "diffEditor.ignoreTrimWhitespace": false,
    },
    "diffEditor.hideUnchangedRegions.enabled": true,
    "diffEditor.experimental.showMoves": true,
    "diffEditor.renderSideBySide": false,
    "explorer.incrementalNaming": "smart",
    "cSpell.enabledFileTypes": {
        "markdown": true,
    },
    "window.titleBarStyle": "custom",
    "markdown-pdf.displayHeaderFooter": false,
    "window.customTitleBarVisibility": "never",
    "vscode_vibrancy.type": "transparent",
    "vscode_vibrancy.theme": "Default Dark",
    "vscode_vibrancy.opacity": 0.7,
    "editor.fontFamily": "'Monocraft Nerd Font', 'Noto'",
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "files.autoSave": "afterDelay",
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.stickyScroll.enabled": false,
    "workbench.browser.openLocalhostLinks": false,
    "workbench.experimental.modernUI": false,
    "terminal.integrated.fontSize": 12,
    "window.autoDetectColorScheme": false,
    "window.controlsStyle": "custom",
    "workbench.colorCustomizations": {
        "terminal.background": "#00000000",
        "editorPane.background": "#1e1e1e00",
        "editorGroupHeader.tabsBackground": "#1e1e1e00",
        "editorGroupHeader.noTabsBackground": "#1e1e1e00",
        "breadcrumb.background": "#1e1e1e00",
        "editorGutter.background": "#1e1e1e00",
        "panel.background": "#1e1e1e00",
        "tab.activeBackground": "#1e1e1e00",
        "tab.unfocusedActiveBackground": "#1e1e1e00",
        "sideBar.background": "#1e1e1eb3",
        "sideBarTitle.background": "#1e1e1eb3",
        "activityBar.background": "#1e1e1eb3",
        "editor.background": "#1e1e1eb3",
        "tab.inactiveBackground": "#1e1e1eb3",
        "tab.unfocusedInactiveBackground": "#1e1e1eb3",
        "editorStickyScroll.background": "#1e1e1ebf",
        "editorStickyScrollGutter.background": "#1e1e1ebf",
        "sideBarStickyScroll.background": "#1e1e1ebf",
        "panelStickyScroll.background": "#1e1e1ebf",
        "terminalStickyScroll.background": "#1e1e1ebf",
        "minimap.background": "#1e1e1ebf",
        "inlineChat.background": "#1e1e1ee6",
        "editorWidget.background": "#1e1e1ee6",
        "editorHoverWidget.background": "#1e1e1ee6",
        "editorSuggestWidget.background": "#1e1e1ee6",
        "notifications.background": "#1e1e1ee6",
        "notificationCenterHeader.background": "#1e1e1ee6",
        "menu.background": "#1e1e1ee6",
        "quickInput.background": "#1e1e1ee6",
        "editor.lineHighlightBorder": "#00000000",
    },
}
