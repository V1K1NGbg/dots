#%PAM-1.0
# Password first; an empty submission starts a fresh fingerprint scan.
# Retain Arch login's shell/nologin, homed, environment and faillock checks.
auth required pam_shells.so
auth requisite pam_nologin.so
auth required pam_faillock.so preauth
-auth [success=3 conv_err=die authtok_err=die default=ignore] pam_systemd_home.so
auth [success=2 auth_err=ignore default=die] pam_unix.so try_first_pass
auth [success=1 default=bad] pam_fprintd.so max-tries=3 timeout=10
auth [default=die] pam_faillock.so authfail
auth optional pam_permit.so
auth required pam_env.so
auth required pam_faillock.so authsucc
