// Generated by scripts/generate-waybar.py; edit that file instead.
{
  "layer": "top",
  "position": "top",
  "start_hidden": true,
  "height": 30,
  "spacing": 3,
  "on-sigusr1": "toggle",
  "modules-left": [
    "group/workspace1",
    "group/workspace2",
    "group/workspace3",
    "group/workspace4",
    "group/workspace5",
    "group/workspace6",
    "group/workspace7",
    "group/workspace8",
    "group/workspace9"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "battery"
  ],
  "clock": {
    "format": "{:%Y-%m-%d  %H:%M}"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%",
    "format-charging": "{capacity}%"
  },
  "tray": {
    "spacing": 8
  },
  "group/workspace1": {
    "orientation": "horizontal",
    "modules": [
      "custom/workspace#1",
      "hyprland/workspaces#apps1"
    ]
  },
  "custom/workspace#1": {
    "return-type": "json",
    "format": "{text}",
    "exec": "cat \"$XDG_RUNTIME_DIR/dots-waybar-$HYPRLAND_INSTANCE_SIGNATURE/$WAYBAR_OUTPUT_NAME-1.json\"",
    "signal": 9,
    "exec-on-event": false,
    "on-click": "hyprctl dispatch 'function() dots.view_at_cursor(1) end'"
  },
  "hyprland/workspaces#apps1": {
    "format": "{windows}",
    "all-outputs": false,
    "active-only": false,
    "show-special": false,
    "ignore-workspaces": [
      "^(?![0-9]*1$).*$"
    ],
    "enable-bar-scroll": false,
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": true,
      "format": "{icon}",
      "icon-size": 16,
      "icon-theme": [
        "Papirus-Dark",
        "Adwaita"
      ],
      "orientation": "horizontal",
      "on-click-window": "~/.config/waybar/focus-window.sh {address} {button}"
    }
  },
  "group/workspace2": {
    "orientation": "horizontal",
    "modules": [
      "custom/workspace#2",
      "hyprland/workspaces#apps2"
    ]
  },
  "custom/workspace#2": {
