/* Shared with Alacritty, Waybar and Hyprland. */
* {
    font: "Monocraft Nerd Font 15";
    bg: #191919f5;
    panel: #242424;
    ink: #f8f8f2;
    muted: #aaaaaa;
    accent: #67ffeb;
    edge: #404040;
    background-color: transparent;
    text-color: @ink;
}
window {
    location: center;
    anchor: center;
    width: 1100px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 6px;
}
mainbox { children: [ inputbar, message, listview ]; padding: 24px; spacing: 18px; }
inputbar {
    children: [ prompt, entry ];
    spacing: 24px;
    padding: 12px 4px 20px;
    border: 0px 0px 1px;
    border-color: @edge;
}
prompt { text-color: @accent; }
entry { placeholder: "Type to search…"; placeholder-color: @muted; cursor-color: @accent; }
message { background-color: @panel; border: 0px 0px 0px 3px; border-color: @accent; border-radius: 6px; }
textbox { padding: 14px 18px; text-color: @muted; }
listview { columns: 1; lines: 8; fixed-height: false; dynamic: false; scrollbar: true; spacing: 6px; }
element {
    children: [ element-text ];
    padding: 12px 16px;
    border-radius: 6px;
    border: 2px;
    border-color: transparent;
    spacing: 14px;
    background-color: transparent;
}
element alternate.normal { background-color: transparent; }
element selected.normal { background-color: #223b37; border-color: @accent; text-color: @ink; }
element selected.active { background-color: #223b37; border-color: @accent; text-color: @ink; }
element selected.urgent { background-color: #442832; border-color: #ff025f; text-color: @ink; }
element normal.urgent { text-color: #ffb247; }
element-text { text-color: inherit; vertical-align: 0.5; highlight: bold underline #67ffeb; }
element-icon { size: 26px; }
scrollbar { handle-width: 3px; handle-color: @edge; padding: 0px 0px 0px 8px; }
