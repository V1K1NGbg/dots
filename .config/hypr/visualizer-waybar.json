    "modules-center": ["custom/spectrum"],
    "custom/spectrum": {
      "exec": "bash ~/.config/hypr/visualizer.sh --stream horizontal",
      "return-type": "json",
      "format": "{text}",
      "rotate": 180,
      "tooltip": false
    }
  },
  {
    "name": "dots-visualizer",
    "position": "left",
    "layer": "bottom",
